// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URI")
}

model User {
  id              String               @id
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  username        String               @db.VarChar(255)
  password        String               @db.VarChar(255)
  nickname        String               @default("")
  avatar          String?               
  userMoments     Moment[]             @relation("BelongsTo")
  friendships     FriendRelationship[] @relation("BelongsTo")
  friendshipsWith FriendRelationship[] @relation("FriendsWith")
}

model Moment {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  url       String   @db.VarChar(255)
  user      User     @relation("BelongsTo", fields: [userId], references: [id])
  userId    String
}

model FriendRelationship {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("BelongsTo", fields: [userId], references: [id])
  userId    String
  friend    User     @relation("FriendsWith", fields: [friendId], references: [id])
  friendId  String
}
