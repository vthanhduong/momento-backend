generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URI")
}

model User {
  id              String       @id
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  username        String       @db.VarChar(255)
  password        String       @db.VarChar(255)
  nickname        String?
  avatar          String?
  friendshipsWith Friendship[] @relation("FriendsWith")
  friendships     Friendship[] @relation("BelongsTo")
  userMoments     Moment[]     @relation("BelongsTo")
}

model Moment {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  url       String   @db.VarChar(255)
  userId    String
  user      User     @relation("BelongsTo", fields: [userId], references: [id])

  @@index([userId], map: "Moment_userId_fkey")
}

model Friendship {
  id           String   @id
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  friendId     String
  friend       User     @relation("FriendsWith", fields: [friendId], references: [id])
  user         User     @relation("BelongsTo", fields: [userId], references: [id])
  isInvitation Int      @db.TinyInt

  @@index([friendId], map: "FriendRelationship_friendId_fkey")
  @@index([userId], map: "FriendRelationship_userId_fkey")
}
